# Codex CLI uses the login on the backend machine. No API key needed.
AI_PROVIDER=codex
# Optional executable override; default: codex on PATH.
# CODEX_BIN=/absolute/path/to/codex
# Alternative: AI_PROVIDER=demo for simulation, or openai for paid API.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
PORT=3001
HOST=127.0.0.1
